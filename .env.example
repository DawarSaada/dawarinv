[TEMPLATE]
# Copy to .env and fill in. Only publishable values belong here — everything in this
# file is injected into the browser bundle at build time.
#
# ---- Required for the inventory app itself ----
# Supabase project URL and anon (publishable) key. Never put a service_role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Optional: cross-app subscription check against the OMS project ----
# When unset, the subscription gate is off and the app runs without a licence check.
VITE_OMS_SUPABASE_URL=
VITE_OMS_SUPABASE_ANON_KEY=

# ---- Optional: presentation ----
# Starting currency for money in the UI. Default SAR. The administrator can change this
# from Settings at runtime (stored in app_settings), so this is only the value a fresh
# database starts with. A per-location currency is a roadmap item, not a setting.
VITE_CURRENCY=SAR
# BCP-47 locale used for number and date formatting. Default en.
VITE_DEFAULT_LOCALE=en

# ---- Optional: Web Push ----
# Public VAPID key. The matching PRIVATE key stays in the push-notifications
# Supabase function secret (VAPID_PRIVATE_KEY).
VITE_VAPID_PUBLIC_KEY=

# There are intentionally no VITE_AI_* variables: every AI call goes through the
# `ai-assistant` edge function so the provider key never reaches the browser.

# ---------------------------------------------------------------------------
# Server-side only — set these as Supabase function secrets, NOT in this file.
#
#   supabase secrets set OPENROUTER_API_KEY=sk-or-v1-...
#   supabase functions deploy ai-assistant
#
# OPENROUTER_API_KEY   (required) provider key for the `ai-assistant` function.
# OPENROUTER_MODEL     model slug; default google/gemini-2.0-flash-001.
#                      Pick a vision-capable model if you send photos, and one that
#                      supports JSON output for the PDF importer.
# OPENROUTER_MODELS    comma-separated allowlist the client may choose from.
# OPENROUTER_FALLBACKS comma-separated models retried on 402/429/5xx.
# OPENROUTER_APP_URL   sent as HTTP-Referer (OpenRouter attribution).
# OPENROUTER_APP_TITLE sent as X-Title.
# OPENROUTER_DENY_DATA_COLLECTION=true  only route to providers that do not
#                      train on or retain prompts.
# AI_MAX_TOKENS        output cap, default 2048.
# AI_TIMEOUT_MS        upstream timeout, default 60000.
# ALLOWED_ORIGINS      browser origins allowed to call the function (CORS).
#
# VAPID_PRIVATE_KEY          secret for the `push-notifications` function.
# SUPABASE_SERVICE_ROLE_KEY  provided automatically to edge functions.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Database migrations (run in the Supabase SQL editor, in this order)
#
#   phase7_integrity_migration.sql   stock ledger: negatives, CHECK, usage guard
#   phase8_product_integrity.sql     duplicate-proofing for product data
#   phase10_app_settings.sql         central settings (currency, transfer rules, retention)
#
# phase10 is what makes administrator settings apply to every user. Until it is
# applied the settings screen says they are stored in this browser only.
# ---------------------------------------------------------------------------
